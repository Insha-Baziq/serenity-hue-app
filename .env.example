# Turso (keep these server-side only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Production schema changes should be applied deliberately before deploys.
# Set this only when a deployment must run the request-time schema bootstrap.
TURSO_AUTO_MIGRATE=false

# Shopify Admin API. Keep its credentials server-side only.
# The app exchanges these for a short-lived server-to-server access token.
SHOPIFY_STORE_DOMAIN=serenityhue.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Parcel2Go Shipping API. Keep both credentials server-side only.
# Default API base: https://www.parcel2go.com (use https://sandbox.parcel2go.com for Sandbox).
PARCEL2GO_CLIENT_ID=
PARCEL2GO_CLIENT_SECRET=
PARCEL2GO_API_BASE_URL=https://www.parcel2go.com
# Set this to the webhook secret configured in Parcel2Go before enabling the webhook.
PARCEL2GO_WEBHOOK_SECRET=

# TikTok Shop API. Keep every value server-side only.
# Use the region assigned to the seller account, for example GB or US.
TIKTOK_SHOP_REGION=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_REDIRECT_URI=
# Generate once with a CSPRNG: 32 random bytes encoded as base64. This key is
# required before existing TikTok OAuth tokens can be encrypted in production.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# TikTok Ads Marketing API (server-only; read-only reporting)
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
TIKTOK_ADS_REDIRECT_URI=https://serenity-hue-operations.vercel.app/api/tiktok-ads/callback
TIKTOK_ADS_ADVERTISER_ID=
# Earliest provider history to retain for the KPI All time view.
TIKTOK_ADS_HISTORY_START_DATE=2026-04-01
# Optional display name; TikTok's advertiser_name is preferred when returned.
TIKTOK_ADS_ADVERTISER_NAME=
# Seller access and refresh tokens are created by OAuth and stored only in the
# server database. Do not add them to browser-visible or tracked files.

# Better Auth. Keep the secret server-side and use a random value of at least
# 32 characters in every environment. Staff sign-up stays disabled by default.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Better Auth Infrastructure dashboard connection key.
BETTER_AUTH_API_KEY=
# Optional comma-separated additional browser origins (for a Vercel preview,
# for example). APP_URL/BETTER_AUTH_URL is always trusted automatically.
BETTER_AUTH_TRUSTED_ORIGINS=
AUTH_ALLOW_SIGN_UP=false
# Optional one-time bootstrap values. Remove them after the first admin is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Temporary deployment protection fallback. Used only when BETTER_AUTH_SECRET
# is not configured yet; remove these once Better Auth is active in production.
INTERNAL_APP_USERNAME=
INTERNAL_APP_PASSWORD=

# QStash schedule verification. QStash calls /api/jobs/reconcile.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public app origin, used when creating a schedule.
APP_URL=http://localhost:3000

# Remote read-only MCP connector. Keep all values server-side only.
# Enable only after the provider-enforced read-only database boundary and
# staging client checks are complete.
MCP_ENABLED=false
MCP_PII_ENABLED=false
# Keep false unless every existing Better Auth account is approved for MCP.
# When true, any authenticated Serenity Hue account may authorize the connector.
MCP_ALLOW_ALL_AUTHENTICATED_USERS=false
MCP_ALLOWED_USER_ID=
MCP_ISSUER_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
# Generate a random secret of at least 32 characters; used only to hash/sign
# OAuth values and cursors.
MCP_OAUTH_SECRET=
# Production must point to a read-only Turso/replica credential. A local file
# URL is acceptable for local testing after the primary schema is migrated.
MCP_READ_DATABASE_URL=
MCP_READ_DATABASE_AUTH_TOKEN=
# Set true only after the deployed database provider has been verified to reject writes.
MCP_READ_DATABASE_ENFORCED=false
# Optional local-only escape hatch for tests/development; never set in prod.
MCP_ALLOW_PRIMARY_READ_FALLBACK=false
# Exact HTTPS redirect URIs, comma-separated. Validated loopback redirects are
# accepted for native clients when registered explicitly.
MCP_ALLOWED_REDIRECT_URIS=
MCP_DCR_ENABLED=true

# Named staff writes through MCP. The connector stays read-only until all three
# settings are deliberately configured. IDs are exact Better Auth user IDs and
# OAuth client registration IDs, not email addresses or display names.
MCP_WRITE_ENABLED=false
MCP_WRITE_ALLOWED_USER_IDS=
MCP_WRITE_ALLOWED_CLIENT_IDS=

# VAT workspace (/vat). Connections are business-wide and set up from the VAT
# page after these are configured; see docs/VAT-WORKSPACE.md. Redirect URIs are
# derived from BETTER_AUTH_URL / APP_URL:
#   <app>/api/vat/connections/dropbox/callback
#   <app>/api/vat/connections/outlook/callback
# base64-encoded 32 random bytes; encrypts Dropbox/Outlook tokens at rest.
VAT_TOKEN_ENCRYPTION_KEY=
# Dropbox app with "App folder" access (business account, not a developer's).
VAT_DROPBOX_APP_KEY=
VAT_DROPBOX_APP_SECRET=
# Microsoft Entra app for Outlook inboxes. Connecting stores authorization only;
# inbox sync is deferred. Tenant "common" allows work and personal accounts.
VAT_MICROSOFT_CLIENT_ID=
VAT_MICROSOFT_CLIENT_SECRET=
VAT_MICROSOFT_TENANT=common
