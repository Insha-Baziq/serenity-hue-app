# Turso (keep these server-side only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shopify Admin API. Keep its credentials server-side only.
# The app exchanges these for a short-lived server-to-server access token.
SHOPIFY_STORE_DOMAIN=serenityhue.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Parcel2Go Shipping API. Keep both credentials server-side only.
# Default API base: https://www.parcel2go.com (use https://sandbox.parcel2go.com for Sandbox).
PARCEL2GO_CLIENT_ID=
PARCEL2GO_CLIENT_SECRET=
PARCEL2GO_API_BASE_URL=https://www.parcel2go.com
# Set this to the webhook secret configured in Parcel2Go before enabling the webhook.
PARCEL2GO_WEBHOOK_SECRET=

# TikTok Shop API. Keep every value server-side only.
# Use the region assigned to the seller account, for example GB or US.
TIKTOK_SHOP_REGION=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_REDIRECT_URI=
# Seller access and refresh tokens are created by OAuth and stored only in the
# server database. Do not add them to browser-visible or tracked files.

# Better Auth. Keep the secret server-side and use a random value of at least
# 32 characters in every environment. Staff sign-up stays disabled by default.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_ALLOW_SIGN_UP=false
# Optional one-time bootstrap values. Remove them after the first admin is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Temporary deployment protection fallback. Used only when BETTER_AUTH_SECRET
# is not configured yet; remove these once Better Auth is active in production.
INTERNAL_APP_USERNAME=
INTERNAL_APP_PASSWORD=

# QStash schedule verification. QStash calls /api/jobs/reconcile.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public app origin, used when creating a schedule.
APP_URL=http://localhost:3000
